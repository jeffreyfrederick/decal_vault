# Copy to .env for anything beyond local dev. See README for details.

# Flask session/cookie signing key. Needs a real random value in production.
SECRET_KEY=

# Shared password gating the /upload, /manage, and delete routes.
DECAL_VAULT_STAFF_PASSWORD=

# Set to 1 for the Werkzeug debugger. Local dev only.
FLASK_DEBUG=0

# Set to 1 once served over HTTPS, so session cookies are marked Secure.
SESSION_COOKIE_SECURE=0

# Optional, defaults to a local SQLite file under instance/.
# DATABASE_URL=

# Optional, defaults to app/static/uploads.
# UPLOAD_FOLDER=
