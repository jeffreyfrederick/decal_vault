# Copy to .env for anything beyond local dev. See README for how these
# get set on Railway.

# Flask session/cookie signing key. Needs a real random value once this
# app is reachable off your machine.
SECRET_KEY=

# Shared password gating the /upload, /manage, and delete routes.
DECAL_VAULT_STAFF_PASSWORD=

# Set to 1 for the Werkzeug debugger. Local dev only - it lets anyone
# who can reach the app run arbitrary code from the browser.
FLASK_DEBUG=0

# Set to 1 once the app is served over HTTPS (e.g. on Railway) so session
# cookies are marked Secure. Leave at 0 for local http:// dev.
SESSION_COOKIE_SECURE=0

# Optional, defaults to a local SQLite file under instance/. Point at a
# managed Postgres database for anything beyond a local demo - SQLite
# doesn't survive a Railway redeploy.
# DATABASE_URL=

# Optional. Defaults to app/static/uploads. Override if mounting a Railway
# volume at a different path.
# UPLOAD_FOLDER=
